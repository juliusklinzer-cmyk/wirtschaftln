# Wirtschaftln — Caddy besorgt sich das TLS-Zertifikat automatisch (Let's Encrypt).
wirtschaftln.de, www.wirtschaftln.de {
    reverse_proxy app:3000
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# Firmengolf-Staging (03.08.2026, Absprache Julius): eigene Container auf
# demselben Server (edge-Netz), Wirtschaftln bleibt unberührt.
# Details: firmengolf-app/deploy/staging/README.md
staging.firmengolf.app {
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Robots-Tag "noindex, nofollow"
    }
    handle /api/* {
        reverse_proxy fg-api:3001
    }
    handle {
        reverse_proxy fg-web:80
    }
}

# Wirtschaftln-Staging (Design-Spielwiese, 29.08.2026): eigener Checkout unter
# /opt/wirtschaftln-staging mit eigener DB (Demodaten), Container am edge-Netz.
staging.wirtschaftln.de {
    reverse_proxy wirtschaftln-staging-app:3000
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Spielwiese, ghört ned in Suchmaschinen
        X-Robots-Tag "noindex, nofollow"
    }
}

# Dart-Turnier "Blink 180" (24.08.2026, Absprache Julius): eigener Container am
# edge-Netz, Wirtschaftln bleibt unberührt. Ein einziger Node-Prozess liefert
# dort Seite UND API aus, deshalb braucht es keine getrennten handle-Blöcke
# wie beim Firmengolf-Staging.
# Details: darts-app/DEPLOY.md
darts.wirtschaftln.de {
    reverse_proxy darts-app:3002
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Private Runde – die App gehört nicht in Suchmaschinen.
        X-Robots-Tag "noindex, nofollow"
    }
}
