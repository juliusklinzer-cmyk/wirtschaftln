{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/domain/**",
              "components/forms/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|Pirata One|Libre Caslon Text))/i]",
        "message": "Font not provided by the design system. Available: Manrope, Pirata One, Libre Caslon Text."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmtBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|holder|icon|size|style|key|ref|className|style|children)$/]",
        "message": "<AmtBadge> doesn't accept that prop. Declared props: title, holder, icon, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmtBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<AmtBadge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|badge|present|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, badge, present, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|solid|iconLeft|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, solid, iconLeft, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeerCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|max|style|key|ref|className|style|children)$/]",
        "message": "<BeerCounter> doesn't accept that prop. Declared props: value, onChange, label, max, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|fullWidth|disabled|iconLeft|iconRight|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, fullWidth, disabled, iconLeft, iconRight, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|framed|pad|interactive|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, framed, pad, interactive, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrestMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:crest|tone|size|motto|align|style|key|ref|className|style|children)$/]",
        "message": "<CrestMark> doesn't accept that prop. Declared props: crest, tone, size, motto, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrestMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|navy|mono)$/]",
        "message": "<CrestMark> tone must be one of 'gold' | 'navy' | 'mono'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrestMark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<CrestMark> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrestMark'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<CrestMark> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|variant|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, variant, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|type|iconLeft|hint|error|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, placeholder, type, iconLeft, hint, error, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KasseEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|photo|grund|betrag|datum|paid|status|gemeldet|kind|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<KasseEntry> doesn't accept that prop. Declared props: name, photo, grund, betrag, datum, paid, status, gemeldet, kind, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KasseEntry'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:strafe|ausgabe)$/]",
        "message": "<KasseEntry> kind must be one of 'strafe' | 'ausgabe'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|photo|amt|since|abende|mass|wirtshaeuser|ring|layout|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PersonCard> doesn't accept that prop. Declared props: name, photo, amt, since, abende, mass, wirtshaeuser, ring, layout, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:tile|row)$/]",
        "message": "<PersonCard> layout must be one of 'tile' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rank|name|photo|value|unit|me|amt|style|key|ref|className|style|children)$/]",
        "message": "<RankRow> doesn't accept that prop. Declared props: rank, name, photo, value, unit, me, amt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|fraktur|action|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, fraktur, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|unit|icon|tone|align|size|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, unit, icon, tone, align, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Stat> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Stat> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|tone|label|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, tone, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blau|gold)$/]",
        "message": "<Switch> tone must be one of 'blau' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VotePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<VotePill> doesn't accept that prop. Declared props: value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|onChange|showValue|style|key|ref|className|style|children)$/]",
        "message": "<StarRating> doesn't accept that prop. Declared props: value, max, size, onChange, showValue, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
