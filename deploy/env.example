# Wirtschaftln — Produktions-Env (auf dem Server nach deploy/.env kopieren und ausfüllen)
# Start immer mit:  docker compose --env-file deploy/.env up -d --build
# (--env-file füllt die Build-Args, env_file im Compose reicht die Werte in den Container)

# Google Maps JS API — Key muss für https://wirtschaftln.de/* freigeschaltet sein
NEXT_PUBLIC_GMAPS_KEY=

# PayPal-Pool für Runden/Strafen (optional — ohne wird der Link ausgeblendet)
NEXT_PUBLIC_PAYPAL_POOL_URL=

# Web-Push (VAPID) — MUSS dasselbe Schlüsselpaar wie lokal sein (app/.env.local),
# sonst verlieren alle Geräte ihr Push-Abo
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:servus@wirtschaftln.de

# Mail über Hetzner (Postfach servus@wirtschaftln.de)
SMTP_HOST=mail.your-server.de
SMTP_PORT=587
SMTP_USER=servus@wirtschaftln.de
SMTP_PASSWORD=
MAIL_FROM=Wirtschaftln <servus@wirtschaftln.de>

# Gründungscode für die Selbst-Registrierung unter /beitreten
# (leer lassen = Aufnahme geschlossen; ohne die Variable gilt 1328)
WN_GRUENDUNGSCODE=1328

# Erst-Admin fürs einmalige Seeding (docker compose exec app node scripts/seed.ts)
WN_ADMIN_EMAIL=julius.klinzer@gmail.com
WN_ADMIN_NAME=Julius Klinzer
WN_ADMIN_PASSWORD=
